{
  "name": "multi-app-portal",
  "private": true,
  "version": "1.0.1",
  "description": "Desktop launcher for Central Core games and tools",
  "author": "B&B Coder",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "electron --version && concurrently -k \"tsx server.ts\" \"electron .\"",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "dist": "npm run build && electron-builder --win nsis",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/genai": "^1.52.0",
    "@node-rs/argon2": "^2.2.1",
    "@zip.js/zip.js": "^2.8.60",
    "7zip-bin": "^5.2.0",
    "better-sqlite3": "^13.0.3",
    "brace-expansion": "5.0.12",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "ffmpeg": "^1.1.3",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "glob": "^13.0.6",
    "hash-wasm": "^4.12.0",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.2",
    "imagetracerjs": "^1.2.6",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "libheif-js": "^1.23.2",
    "lucide-react": "^0.474.0",
    "mammoth": "^1.13.0",
    "motion": "^12.0.0",
    "openskp": "^1.3.0",
    "otplib": "^13.4.0",
    "pdfjs-dist": "^6.2.108",
    "protobufjs": "^7.6.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.5",
    "three": "^0.186.1",
    "whisper-node": "^1.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "com.centralcore.launcher",
    "productName": "Central Core",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "fcp-electron.cjs",
      "Assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "general/Tools/File explorer/FCP (File Converter Pro)/whisper-runtime",
        "to": "whisper-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": true,
    "win": {
      "icon": "Assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Central-Core-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "core-js@3.49.0": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.27.2": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "express": {
      "qs": "^6.16.0"
    }
  }
}
